# Banco de dados PostgreSQL
# DATABASE_URL: usada pela aplicação em tempo de execução (pode ser a conexão
#   "pooled"/pgbouncer do seu provedor, ex: Neon, Supabase).
# DIRECT_URL: conexão direta (sem pooler), usada só para migrações do Prisma.
#   Se seu Postgres não usa pooler, use o mesmo valor nas duas variáveis.
DATABASE_URL="postgresql://usuario:senha@host-pooler/novaloja?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/novaloja?sslmode=require"

# Auth.js — gere um valor aleatório forte com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-aleatorio-forte"
NEXTAUTH_URL="http://localhost:3000"

# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers/panel/app)
# Use as credenciais de PRODUÇÃO quando for para o ar de verdade.
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""

# SMTP — usado para enviar e-mails transacionais (confirmação de pedido, etc.)
# Se deixado em branco, os e-mails só serão exibidos no console do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NovaLoja <naoresponda@sualoja.com.br>"

# URL pública base do site (usada em e-mails e nos retornos do Mercado Pago)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Usados apenas pelo script de seed (prisma/seed.ts) para criar o admin inicial
ADMIN_EMAIL="admin@sualoja.com.br"
ADMIN_PASSWORD="troque-esta-senha"
